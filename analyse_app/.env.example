# analyse.pdhc — template .env. Operator copies to .env and fills.
# Loopback-only deploy: app 127.0.0.1:9110, db 127.0.0.1:9111.

COMPOSE_PROJECT_NAME=analyse_pdhc
APP_PORT=9110
DB_PORT=9111
DB_VOLUME=analyse_pdhc_pgdata

# --- Database --------------------------------------------------------------
POSTGRES_USER=analyse_user
POSTGRES_PASSWORD=
POSTGRES_DB=analyse_db
# DATABASE_URL is injected by docker-compose (app service). For a bare-metal
# run set it explicitly, e.g.:
#   DATABASE_URL=postgresql://analyse_user:PASS@127.0.0.1:9111/analyse_db

# --- Auth (analysis-phase, bearer tokens + SSO web login) ------------------
# AUTH_MODE=off loads a dev SU blob (session_phases:["analysis"]) — Rule 23,
# LOCAL DEV ONLY. Production is always sso. Never ship AUTH_MODE=off.
AUTH_MODE=off

# analyse validates each operator's bearer token against sso.pdhc
# /api/auth/me/service using its own registered client credentials, and
# re-validates on every request (Rule 11). Required when AUTH_MODE=sso.
SSO_BASE_URL=https://sso.pdhc.se
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Web login flow: sso.pdhc redirects the browser back to this callback with
# token+state after authenticating. Must match the value registered in
# sso.pdhc for the analyse client. Required when AUTH_MODE=sso.
SSO_CALLBACK_URL=https://analyse.pdhc.se/auth/callback

# Session-cookie signing key for the web login flow. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# "dev" fallback is LOCAL DEV ONLY — set a real random value on the server.
SECRET_KEY=

# --- Inbound service-key callers (KNOWN_SERVICES) --------------------------
# gateway.pdhc (#291) calls /api/v1/observations; monitor.pdhc (#292) calls
# the federated aux endpoints. Each presents its OWN key here; copy the
# matching value from that service's .env.
GATEWAY_PDHC_SERVICE_KEY=
MONITOR_PDHC_SERVICE_KEY=

# --- analyse's OWN outbound read identity to CDR2–6 ------------------------
# Presented to each CDR as X-Source-Service: analyse.pdhc + X-Service-Key.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# (#541 flips CDR2–6 to accept this identity for analyse reads.)
ANALYSE_PDHC_SERVICE_KEY=

# --- Consent join (ips.pdhc analysis-filter, research reads) ---------------
# Cohort member sets pass through ips's analysis-filter (purpose=research)
# before persist/aggregate; analyse calls it with ANALYSE_PDHC_SERVICE_KEY.
IPS_BASE_URL=https://ips.pdhc.se

# --- CDR federation (analyse FEDERATES reads across CDR2–6) ----------------
# Comma-separated per-CDR base URLs. Two accepted forms per item:
#   plain URL   —  https://cdr2.pdhc.se           (cdr_id from hostname)
#   <id>=<url>  —  cdr2=http://127.0.0.1:9146      (explicit id; loopback)
# Server-side loopback/docker reach on miserver (no tunnel), e.g.:
#   CDR_ENDPOINTS=cdr2=http://127.0.0.1:9146,cdr3=http://127.0.0.1:9246,cdr4=http://127.0.0.1:9346,cdr5=http://127.0.0.1:9446,cdr6=http://127.0.0.1:9055
CDR_ENDPOINTS=

# Per-request fan-out timeout (seconds) for CDR reads. Default 15.
CDR_FANOUT_TIMEOUT=15
