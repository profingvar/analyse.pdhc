# analyse.pdhc — environment template (Rule 23). Copy to .env and fill in.
#
# This file did not exist until 2026-10-16 (#830), which is why several of the
# variables below had only ever existed on the server. A rollback or a fresh
# deploy would have silently lost them, and analyse degrades rather than
# crashing on a missing variable, so the symptom would have been features
# quietly not working.
#
# NO REAL VALUE BELONGS IN THIS FILE. It is committed. Secrets are marked
# <generate> and the operator fills them in .env, which is gitignored.

# ── compose / ports (see CLAUDE.md §3 for the block that belongs to analyse) ──
COMPOSE_PROJECT_NAME=analyse_pdhc
APP_PORT=9110
DB_PORT=9111
DB_VOLUME=analyse_pdhc_pgdata

# ── database ────────────────────────────────────────────────────────────────
POSTGRES_USER=analyse_user
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=analyse_db

# ── auth. AUTH_MODE=off is LOCAL DEV ONLY and must never ship (Rule 23) ─────
AUTH_MODE=sso
SSO_BASE_URL=https://sso.pdhc.se
SSO_CLIENT_ID=analyse-pdhc
SSO_CLIENT_SECRET=<generate>
SSO_CALLBACK_URL=https://analyse.pdhc.se/auth/callback
SECRET_KEY=<generate>

# ── service keys. Each must match the holder's own copy, or the call 403s. ──
# GATEWAY_PDHC_SERVICE_KEY is the key gateway presents to analyse; it must
# equal gateway's and cdr1's copies (three-way, #440).
GATEWAY_PDHC_SERVICE_KEY=<generate>
# ANALYSE_PDHC_SERVICE_KEY is the key analyse presents to the CDRs; each CDR
# holds the same value under the same name.
ANALYSE_PDHC_SERVICE_KEY=<generate>

# ── siblings. Cross-service base URLs are the PUBLIC subdomain (#830). ──────
# host.docker.internal is preliminary-work scaffolding: it bypasses the reverse
# proxy, so a call verified over loopback has not been verified over the path
# real traffic takes, and it encodes "that service is on this machine" into
# configuration.
IPS_BASE_URL=https://ips.pdhc.se
PLAN_BASE_URL=https://plan.pdhc.se

# CDR_ENDPOINTS is <name>=<base url> pairs, comma separated. cdr4 and cdr5 were
# destroyed 2026-10-05 and must not be listed — leaving them in makes every
# cohort resolve against a permanently degraded federation.
#
# cdr6 (cdr_6) was scrapped 2026-11-20 and must not be listed either.
CDR_ENDPOINTS=cdr1=https://cdr.pdhc.se,cdr2=https://cdr2.pdhc.se,cdr3=https://cdr3.pdhc.se
CDR_FANOUT_TIMEOUT=15

# ── role. coordinator fans out to the nodes; node serves one CDR (ADR-0005). ─
ANALYSE_ROLE=coordinator

# ── ips. require_auth reads ONLY the Authorization header; a key sent as
# X-API-Key is silently ignored and is indistinguishable from no key at all. ──
IPS_API_KEY=<generate>

# #931: read_only service key plan.pdhc issues to analyse.pdhc (= plan's ANALYSE_PDHC_SERVICE_KEY).
PLAN_SOURCE_SERVICE=analyse.pdhc
PLAN_SERVICE_KEY=
